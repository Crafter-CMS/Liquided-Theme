{% assign ptype = product.type | default: 'in_game' %}
{% assign label_in_game = settings.store.type_in_game | default: 'Oyuna teslim' %}
{% assign label_digital = settings.store.type_digital | default: 'Dijital kod' %}
{% assign label_downloadable = settings.store.type_downloadable | default: 'İndirilebilir' %}
{% assign game = server.game | default: 'minecraft' %}
<div class="container max-w-[1100px] mx-auto px-4 mt-8 mb-24">
  <div class="flex flex-wrap items-center gap-2 text-sm font-bold text-gray-500 mb-6">
    <a href="/store" class="hover:text-primary">Mağaza</a>
    {% if ptype == 'in_game' and server.id %}
      <span>/</span>
      <a href="/store/{{ server.slug }}" class="hover:text-primary">{{ server.name }}</a>
    {% endif %}
    {% if category.id %}
      <span>/</span>
      <a href="/store/{{ server.slug }}/{{ category.slug }}" class="hover:text-primary">{{ category.name }}</a>
    {% endif %}
    <span>/</span>
    <span class="text-gray-900">{{ product.name }}</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_380px] gap-8">
    <div class="space-y-6">
      <div class="bg-white border border-gray-100 rounded-[2rem] p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8">
          <div>
            <div class="aspect-square rounded-3xl bg-gray-50 border border-gray-100 flex items-center justify-center overflow-hidden">
              {% if product.images and product.images.size > 0 %}
                <img id="mainProductImage" src="{{ product.images[0] }}" alt="{{ product.name }}" class="w-full h-full object-contain p-6">
              {% elsif product.image != blank %}
                <img id="mainProductImage" src="{{ product.image }}" alt="{{ product.name }}" class="w-full h-full object-contain p-6">
              {% endif %}
            </div>
            {% if product.images and product.images.size > 1 %}
              <div class="flex gap-2 mt-3 overflow-x-auto">
                {% for img in product.images %}
                  <button type="button" onclick="document.getElementById('mainProductImage').src='{{ img }}'" class="w-16 h-16 rounded-xl border border-gray-200 bg-white p-1 shrink-0">
                    <img src="{{ img }}" alt="" class="w-full h-full object-contain">
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="text-[11px] font-black uppercase tracking-widest bg-gray-900 text-white rounded-full px-3 py-1">
                {% if ptype == 'digital' %}{{ label_digital }}{% elsif ptype == 'downloadable' %}{{ label_downloadable }}{% else %}{{ label_in_game }}{% endif %}
              </span>
              {% if ptype == 'in_game' and server.id %}
                <span class="text-[11px] font-black uppercase tracking-widest bg-gray-100 text-gray-700 rounded-full px-3 py-1">
                  {% case game %}
                    {% when 'fivem' %}FiveM
                    {% when 'rust' %}Rust
                    {% when 'gmod' %}Garry's Mod
                    {% when 'cs2' %}CS2
                    {% when 'ark' %}ARK
                    {% when 'dayz' %}DayZ
                    {% when 'empyrion' %}Empyrion
                    {% when 'mtasa' %}MTA:SA
                    {% when 'samp' %}SA-MP
                    {% when 'forest' %}The Forest
                    {% when 'unturned' %}Unturned
                    {% when 'valheim' %}Valheim
                    {% else %}Minecraft
                  {% endcase %}
                </span>
              {% endif %}
              {% if product.tags %}
                {% for tag in product.tags %}
                  <span class="text-[11px] font-bold text-primary bg-blue-50 rounded-full px-3 py-1">#{{ tag }}</span>
                {% endfor %}
              {% endif %}
            </div>
            <h1 class="text-4xl font-black text-gray-900 tracking-tight leading-tight">{{ product.name }}</h1>
            <p class="text-gray-500 font-medium mt-4">
              {% if ptype == 'digital' %}
                Kod yalnızca satın alan hesabın lisanslarında görünür.
              {% elsif ptype == 'downloadable' %}
                {% if product.hasFile %}Dosya hazır. İndirme bağlantısı lisanstan alınır.{% else %}Bu ürüne henüz dosya eklenmemiş.{% endif %}
              {% else %}
                {% if product.serverIds and product.serverIds.size > 1 %}
                  {{ product.serverIds.size }} sunucuya teslim edilir.
                {% elsif server.id %}
                  {{ server.name }} sunucusuna teslim edilir.
                {% else %}
                  {{ label_in_game }}.
                {% endif %}
              {% endif %}
            </p>
            <div class="mt-6 text-sm font-bold text-gray-500">
              {% if ptype == 'in_game' and product.stock <= 0 %}
                Stok sınırsız
              {% elsif product.stock <= 0 %}
                Stokta yok
              {% elsif product.stock <= 10 %}
                Son {{ product.stock }} adet
              {% else %}
                Stok: {{ product.stock }}
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white border border-gray-100 rounded-[2rem] p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4">Açıklama</h2>
        <div class="prose max-w-none text-gray-600">
          {{ product.description | lexical_html | default: '<p class="text-gray-400">Açıklama eklenmemiş.</p>' }}
        </div>
      </div>
    </div>

    <aside class="bg-white border border-gray-100 rounded-[2rem] p-6 h-fit lg:sticky lg:top-24 shadow-sm">
      <div class="text-xs font-black uppercase tracking-widest text-gray-400 mb-2">Fiyat</div>
      {% if product.discountValue and product.discountValue > 0 %}
        <div class="text-sm font-bold text-gray-400 line-through">{{ product.price }} ₺</div>
        <div class="text-4xl font-black text-gray-900">
          {% if product.discountType == 'percentage' %}
            {{ product.price | times: product.discountValue | divided_by: 100 | minus: product.price | abs }} ₺
          {% else %}
            {{ product.price | minus: product.discountValue }} ₺
          {% endif %}
        </div>
      {% else %}
        <div class="text-4xl font-black text-gray-900">{{ product.price }} ₺</div>
      {% endif %}

      <label class="block text-sm font-bold text-gray-700 mt-6 mb-2">Adet
        <input id="buy-qty" type="number" min="1" value="1" class="mt-2 w-full rounded-xl border border-gray-200 px-3 py-3 font-bold">
      </label>

      <button id="buy-balance" type="button" class="w-full mt-4 bg-primary text-white font-black rounded-2xl py-4">Bakiyeyle al</button>
      <button id="buy-card" type="button" class="w-full mt-2 bg-gray-900 text-white font-bold rounded-2xl py-3">Kartla al</button>
      <button id="buy-add" type="button" class="w-full mt-2 bg-gray-100 text-gray-800 font-bold rounded-2xl py-3">Sepete ekle</button>
      <a href="/licenses" class="block text-center text-xs font-bold text-gray-400 mt-4">Lisanslarım</a>
    </aside>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var product = {
      id: {{ product.id | json }},
      name: {{ product.name | json }},
      price: {{ product.price | default: 0 | json }},
      image: {{ product.image | json }},
      images: {{ product.images | json }},
      slug: {{ product.slug | json }},
      type: {{ ptype | json }},
      discountType: {{ product.discountType | json }},
      discountValue: {{ product.discountValue | default: 0 | json }},
      hasFile: {{ product.hasFile | default: false | json }},
      serverIds: {{ product.serverIds | json }},
      serverSlug: {{ server.slug | json }},
      categorySlug: {{ category.slug | json }}
    };
    if (window.CrafterStore) {
      window.CrafterStore.bindProduct(product, { signedIn: {% if customer %}true{% else %}false{% endif %} });
    }
  });
</script>
