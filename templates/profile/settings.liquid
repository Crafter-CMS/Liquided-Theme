{% if customer %}
  <div class="container max-w-[1350px] mx-auto px-4 sm:px-6 py-8 sm:py-12 min-h-[60vh]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Sol Kolon: Profil Bilgileri, İstatistikler ve Navigasyon -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Profil Kartı -->
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm relative overflow-hidden flex flex-col items-center text-center">
          <!-- Dekoratif Arkaplan -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-[100px] -mr-8 -mt-8"></div>

          <div class="relative w-32 h-32 mb-6">
            <div class="absolute inset-0 bg-primary/20 rounded-full blur-xl"></div>
            <img
              src="https://mc-heads.net/avatar/{{ customer.username }}/128"
              alt="{{ customer.username }}"
              class="relative w-full h-full object-cover rounded-2xl shadow-md border-2 border-white"
            >
          </div>

          {% if customer.role %}
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider mb-4 border"
              style="background-color: {{ customer.role.color }}15; color: {{ customer.role.color }}; border-color: {{ customer.role.color }}30;"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              {{ customer.role.name }}
            </div>
          {% endif %}

          <h1 class="text-3xl font-black text-gray-900 mb-2">{{ customer.username }}</h1>

          <div class="flex items-center justify-center gap-4 text-sm font-medium text-gray-500 mt-2">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Kayıt: {{ customer.createdAt | date: '%d.%m.%Y' }}
            </div>
          </div>
        </div>

        <!-- İstatistikler -->
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-4">İstatistikler</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-gray-400">Bakiye</div>
                  <div class="text-lg font-black text-gray-900">{{ customer.balance | default: 0 }} ₺</div>
                </div>
              </div>
            </div>
            
            <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-gray-400">Eşyalar</div>
                  <div class="text-lg font-black text-gray-900">{{ customer.chest.size | default: 0 }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigasyon (Tab Butonları) -->
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Menü</h3>
          <div class="space-y-2 flex flex-col">
            <a
              href="/profile"
              class="w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left text-gray-500 hover:bg-gray-50 border-2 border-transparent"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
              </svg>
              Profil Duvarı
            </a>
            <a
              href="/profile?tab=inventory"
              class="w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left text-gray-500 hover:bg-gray-50 border-2 border-transparent"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              Envanterim
            </a>
            <button
              type="button"
              onclick="switchSettingsTab('tab-general')"
              id="sidebar-btn-general"
              class="sidebar-tab-link w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left bg-primary/5 text-primary border-2 border-primary/20"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Ayarlar
            </button>
            <button
              type="button"
              onclick="switchSettingsTab('tab-discord')"
              id="sidebar-btn-discord"
              class="sidebar-tab-link w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left text-gray-500 hover:bg-gray-50 border-2 border-transparent"
            >
              <i class="fa-brands fa-discord text-lg text-[#5865F2]"></i>
              Discord
            </button>
            <button
              type="button"
              onclick="switchSettingsTab('tab-2fa')"
              id="sidebar-btn-2fa"
              class="sidebar-tab-link w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left text-gray-500 hover:bg-gray-50 border-2 border-transparent"
            >
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              2FA Güvenlik
            </button>
            <a
              href="#"
              onclick="logoutAccount(); return false;"
              class="w-full flex items-center gap-3 p-4 rounded-2xl font-bold transition-all text-left text-red-500 hover:bg-red-50 border-2 border-transparent"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Çıkış Yap
            </a>
          </div>
        </div>
      </div>

      <!-- Sağ Kolon: Ayarlar İçeriği -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Settings Sub-Tabs Header -->
        <div class="bg-white rounded-2xl p-2 border border-gray-100 shadow-sm flex flex-wrap gap-2">
          <button
            type="button"
            onclick="switchSettingsTab('tab-general')"
            id="tab-btn-general"
            class="settings-tab-btn flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2 bg-primary text-white shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>Genel & Şifre</span>
          </button>

          <button
            type="button"
            onclick="switchSettingsTab('tab-discord')"
            id="tab-btn-discord"
            class="settings-tab-btn flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2 text-gray-600 hover:bg-gray-50"
          >
            <i class="fa-brands fa-discord text-base"></i>
            <span>Discord</span>
          </button>

          <button
            type="button"
            onclick="switchSettingsTab('tab-2fa')"
            id="tab-btn-2fa"
            class="settings-tab-btn flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2 text-gray-600 hover:bg-gray-50"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span>2FA Güvenlik</span>
          </button>
        </div>

        <!-- ========================================== -->
        <!-- TAB 1: GENEL PROFİL & ŞİFRE -->
        <!-- ========================================== -->
        <div id="tab-general" class="settings-content bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-sm animate-[fade-in_200ms_ease-out]">
          <h2 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Profil Ayarları
          </h2>

          <!-- Başarı Mesajı -->
          <div id="settings-success" class="hidden mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 font-bold flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Değişiklikleriniz başarıyla kaydedildi!
          </div>

          <!-- Hata Mesajı -->
          <div id="settings-error" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 font-bold flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span id="settings-error-text">Bir hata oluştu.</span>
          </div>

          <form id="settings-form" class="space-y-6 max-w-lg">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Kullanıcı Adı</label>
              <input
                type="text"
                value="{{ customer.username }}"
                disabled
                class="w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded-xl text-gray-500 font-medium cursor-not-allowed"
              >
              <p class="text-xs text-gray-400 mt-1 font-medium">Kullanıcı adı değiştirilemez.</p>
            </div>

            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">E-posta Adresi</label>
              <input
                type="email"
                id="input-email"
                value="{{ customer.email }}"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-900 font-medium"
              >
            </div>

            <div class="pt-4 border-t border-gray-100">
              <h4 class="text-lg font-bold text-gray-900 mb-2">Şifre Değiştir</h4>
              <p class="text-xs text-gray-500 mb-4">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakabilirsiniz.</p>

              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-bold text-gray-700 mb-2">Mevcut Şifre</label>
                  <input
                    type="password"
                    id="input-current-password"
                    placeholder="••••••••"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-900 font-medium"
                  >
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-700 mb-2">Yeni Şifre</label>
                  <input
                    type="password"
                    id="input-new-password"
                    placeholder="••••••••"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-900 font-medium"
                  >
                </div>
              </div>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                id="btn-save-settings"
                class="px-8 py-3.5 bg-primary hover:brightness-110 text-white font-bold rounded-xl transition-all shadow-md shadow-primary/20 w-full sm:w-auto disabled:opacity-50"
              >
                Değişiklikleri Kaydet
              </button>
            </div>
          </form>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: DISCORD ENTEGRASYONU -->
        <!-- ========================================== -->
        <div id="tab-discord" class="settings-content hidden bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-sm animate-[fade-in_200ms_ease-out]">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-black text-gray-900 flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#5865F2]/10 text-[#5865F2] flex items-center justify-center">
                <i class="fa-brands fa-discord text-xl"></i>
              </div>
              Discord Hesabı
            </h2>
            <div id="discordStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600">
              Yükleniyor...
            </div>
          </div>

          <p class="text-gray-500 text-sm font-medium mb-8 leading-relaxed">
            Discord hesabınızı bağlayarak tek tıkla hızlı giriş yapabilir, sunucumuzdaki rollerinizi otomatik senkronize edebilir ve özel ayrıcalıklara erişebilirsiniz.
          </p>

          <!-- Discord Card State Container -->
          <div id="discordCardContainer" class="p-6 rounded-2xl border border-gray-200 bg-gray-50/50 mb-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gray-200 flex items-center justify-center overflow-hidden shrink-0">
                <img id="discordAvatar" src="" class="w-full h-full object-cover hidden" alt="Discord Avatar">
                <i id="discordDefaultIcon" class="fa-brands fa-discord text-2xl text-gray-400"></i>
              </div>
              <div class="flex-grow min-w-0">
                <div id="discordUsernameText" class="font-black text-gray-900 text-base truncate">Discord Bağlı Değil</div>
                <div id="discordSubText" class="text-xs text-gray-500 mt-0.5">Hesabınızı şimdi bağlayın</div>
              </div>
              <div id="discordActionBtnContainer">
                <button
                  type="button"
                  id="btnDiscordConnect"
                  onclick="connectDiscord()"
                  class="px-5 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-[#5865F2]/20 flex items-center gap-2"
                >
                  <i class="fa-brands fa-discord"></i>
                  <span>Discord'u Bağla</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Benefits Box -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gray-100">
            <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-gray-100">
              <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-xs">Tek Tıkla Giriş</h4>
                <p class="text-[11px] text-gray-500 mt-0.5">Şifre girmeden Discord OAuth ile anında oturum açın.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-gray-100">
              <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-xs">Rol & VIP Eşleme</h4>
                <p class="text-[11px] text-gray-500 mt-0.5">Sitedeki VIP veya yetkileriniz Discord sunucusuna yansıtılsın.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 3: 2FA GÜVENLİK (TWO-FACTOR AUTH) -->
        <!-- ========================================== -->
        <div id="tab-2fa" class="settings-content hidden bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-sm animate-[fade-in_200ms_ease-out]">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-black text-gray-900 flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              İki Aşamalı Doğrulama (2FA)
            </h2>
            <div id="twofaOverallBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600">
              Yükleniyor...
            </div>
          </div>

          <p class="text-gray-500 text-sm font-medium mb-8 leading-relaxed">
            İki aşamalı doğrulama, hesabınıza giriş yapılırken şifrenize ek olarak ikinci bir güvenlik adımı ekleyerek hesabınızı tam koruma altına alır.
          </p>

          <!-- 2FA Methods List -->
          <div class="space-y-4 mb-8">
            <!-- 1. Google Authenticator / Authy -->
            <div class="p-5 rounded-2xl border border-gray-200 bg-white hover:border-gray-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
