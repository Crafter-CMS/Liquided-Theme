  <script>
    let generatedRecoveryCodesCache = [];

    function switchSettingsTab(tabId) {
      document.querySelectorAll('.settings-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.settings-tab-btn').forEach(btn => {
        btn.classList.remove('bg-primary', 'text-white', 'shadow-sm');
        btn.classList.add('text-gray-600', 'hover:bg-gray-50');
      });
      document.querySelectorAll('.sidebar-tab-link').forEach(btn => {
        btn.classList.remove('bg-primary/5', 'text-primary', 'border-primary/20');
        btn.classList.add('text-gray-500', 'hover:bg-gray-50', 'border-transparent');
      });

      const targetContent = document.getElementById(tabId);
      const suffix = tabId.replace('tab-', '');
      const targetBtn = document.getElementById(`tab-btn-${suffix}`);
      const sidebarBtn = document.getElementById(`sidebar-btn-${suffix}`);

      if (targetContent) targetContent.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.classList.add('bg-primary', 'text-white', 'shadow-sm');
        targetBtn.classList.remove('text-gray-600', 'hover:bg-gray-50');
      }
      if (sidebarBtn) {
        sidebarBtn.classList.add('bg-primary/5', 'text-primary', 'border-primary/20');
        sidebarBtn.classList.remove('text-gray-500', 'hover:bg-gray-50', 'border-transparent');
      }
    }

    function openModal(id) {
      document.getElementById(id)?.classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id)?.classList.add('hidden');
    }

    // ==========================================
    // DISCORD ENTEGRASYONU FONKSİYONLARI
    // ==========================================
    async function loadDiscordStatus() {
      const badge = document.getElementById('discordStatusBadge');
      const avatar = document.getElementById('discordAvatar');
      const defaultIcon = document.getElementById('discordDefaultIcon');
      const usernameText = document.getElementById('discordUsernameText');
      const subText = document.getElementById('discordSubText');
      const actionContainer = document.getElementById('discordActionBtnContainer');

      try {
        const res = await fetch('/api/storefront/v2/users/me/discord/status');
        const json = await res.json();
        const data = json.data || json;
        const isLinked = data.isLinked === true || data.discordLinked === true || json.isLinked === true;
        const dUsername = data.discordUsername || json.discordUsername;

        if (isLinked) {
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700';
          badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span> Bağlandı';

          usernameText.innerText = dUsername || 'Bağlı Discord Hesabı';
          subText.innerText = 'Hesabınız Discord ile başarıyla eşleştirildi.';

          if (data.avatar) {
            avatar.src = data.avatar;
            avatar.classList.remove('hidden');
            defaultIcon.classList.add('hidden');
          } else {
            avatar.classList.add('hidden');
            defaultIcon.classList.remove('hidden');
          }

          actionContainer.innerHTML = `
            <button
              type="button"
              onclick="unlinkDiscord()"
              class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold rounded-xl transition-all border border-red-200"
            >
              Bağlantıyı Kaldır
            </button>
          `;
        } else {
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-500';
          badge.innerText = 'Bağlı Değil';

          usernameText.innerText = 'Discord Bağlı Değil';
          subText.innerText = 'Hesabınızı bağlayarak tek tıkla giriş yapın.';
          avatar.classList.add('hidden');
          defaultIcon.classList.remove('hidden');

          actionContainer.innerHTML = `
            <button
              type="button"
              onclick="connectDiscord()"
              class="px-5 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-[#5865F2]/20 flex items-center gap-2"
            >
              <i class="fa-brands fa-discord"></i>
              <span>Discord'u Bağla</span>
            </button>
          `;
        }
      } catch (e) {
        if (badge) badge.innerText = 'Hata';
      }
    }

    async function connectDiscord() {
      try {
        const redirectUri = window.location.origin + '/profile';
        const res = await fetch(`/api/storefront/v2/auth/discord?action=connect&redirectUri=${encodeURIComponent(redirectUri)}`);
        const data = await res.json();
        if (data.success && data.data?.oauthUrl) {
          window.location.href = data.data.oauthUrl;
        } else if (data.oauthUrl) {
          window.location.href = data.oauthUrl;
        } else {
          showToast(data.message || 'Discord bağlantı URL\'si alınamadı.', 'error');
        }
      } catch (e) {
        showToast('Discord servisine bağlanılamadı.', 'error');
      }
    }

    async function unlinkDiscord() {
      if (!confirm('Discord bağlantınızı kaldırmak istediğinizden emin misiniz?')) return;
      try {
        const res = await fetch('/api/storefront/v2/users/me/discord/unlink', {
          method: 'POST',
        });
        const data = await res.json();
        if (data.success) {
          showToast('Discord bağlantısı kaldırıldı.', 'success');
          await loadDiscordStatus();
        } else {
          showToast(data.message || 'Bağlantı kaldırılamadı.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      }
    }

    // ==========================================
    // 2FA GÜVENLİK FONKSİYONLARI
    // ==========================================
    async function loadTwoFaStatus() {
      const overallBadge = document.getElementById('twofaOverallBadge');
      const badgeAuth = document.getElementById('badgeAuthenticator');
      const actionAuth = document.getElementById('actionAuthenticator');
      const badgeEmail = document.getElementById('badgeEmail2Fa');
      const actionEmail = document.getElementById('actionEmail2Fa');
      const advancedSec = document.getElementById('twofaAdvancedSection');
      const selectPrimary = document.getElementById('selectPrimaryMethod');
      const recBadge = document.getElementById('recoveryCodesCountBadge');

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/status');
        const json = await res.json();
        const data = json.data || json;

        // Check if 2FA is enabled (backend returns: { enabled: true, methods: ["authenticator"] ... })
        const is2FaEnabled = data.enabled === true || data.isEnabled === true || json.enabled === true || json.isEnabled === true;

        // Extract methods array
        let methodsArray = [];
        if (Array.isArray(data.methods)) {
          methodsArray = data.methods;
        } else if (Array.isArray(json.methods)) {
          methodsArray = json.methods;
        } else if (data.methods && typeof data.methods === 'object') {
          methodsArray = Object.keys(data.methods).filter(k => data.methods[k]?.isEnabled === true || data.methods[k] === true);
        }

        const hasAuth = methodsArray.includes('authenticator');
        const hasEmail = methodsArray.includes('email');
        const primary = data.primaryMethod || json.primaryMethod || 'authenticator';
        const recCount = data.recoveryCodesCount !== undefined ? data.recoveryCodesCount : (data.recoveryCodesLeft !== undefined ? data.recoveryCodesLeft : (json.recoveryCodesCount !== undefined ? json.recoveryCodesCount : 0));

        if (is2FaEnabled) {
          overallBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700';
          overallBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span> Aktif';
          advancedSec.classList.remove('hidden');

          if (selectPrimary) {
            selectPrimary.value = primary;
          }

          if (recBadge) {
            recBadge.innerText = `${recCount} kod mevcut`;
          }

          // Authenticator Method Status
          if (hasAuth) {
            badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-green-100 text-green-700';
            badgeAuth.innerText = 'Aktif';
            actionAuth.innerHTML = `
              <button type="button" onclick="startAuthenticatorSetup()" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all">
                Yeniden Kur
              </button>
            `;
          } else {
            badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-500';
            badgeAuth.innerText = 'Kapalı';
            actionAuth.innerHTML = `
              <button type="button" onclick="startAuthenticatorSetup()" class="px-4 py-2 bg-primary hover:brightness-110 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Kurulum Yap
              </button>
            `;
          }

          // Email 2FA Method Status
          if (hasEmail) {
            badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-green-100 text-green-700';
            badgeEmail.innerText = 'Aktif';
            actionEmail.innerHTML = `
              <button type="button" onclick="openDisable2FaModal()" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all">
                Kapat
              </button>
            `;
          } else {
            badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-500';
            badgeEmail.innerText = 'Kapalı';
            actionEmail.innerHTML = `
              <button type="button" onclick="startEmail2FaSetup()" class="px-4 py-2 bg-primary hover:brightness-110 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Aktifleştir
              </button>
            `;
          }
        } else {
          overallBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-500';
          overallBadge.innerText = 'Devre Dışı';
          advancedSec.classList.add('hidden');

          badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-500';
          badgeAuth.innerText = 'Kapalı';
          actionAuth.innerHTML = `
            <button type="button" onclick="startAuthenticatorSetup()" class="px-4 py-2 bg-primary hover:brightness-110 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
              Kurulum Yap
            </button>
          `;

          badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-500';
          badgeEmail.innerText = 'Kapalı';
          actionEmail.innerHTML = `
            <button type="button" onclick="startEmail2FaSetup()" class="px-4 py-2 bg-primary hover:brightness-110 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
              Aktifleştir
            </button>
          `;
        }

        // Discord 2FA Status (Bot DM flow)
        const badgeDiscord = document.getElementById('badgeDiscord2Fa');
        const actionDiscord = document.getElementById('actionDiscord2Fa');
        const discord2FaSub = document.getElementById('discord2FaSubText');
        const isDiscordLinked = data.discordLinked === true || data.isDiscordLinked === true || (data.discordUsername && data.discordUsername !== null) || data.discordId != null;
        const hasDiscord2Fa = methodsArray.includes('discord');
        const dUsername = data.discordUsername || json.discordUsername;

        if (badgeDiscord && actionDiscord) {
          if (!isDiscordLinked) {
            // Discord hesabı hiç bağlı değil
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-500';
            badgeDiscord.innerText = 'Kapalı';
            if (discord2FaSub) discord2FaSub.innerHTML = `<span class="text-amber-600 font-semibold">⚠️ Önce Discord hesabınızı bağlayınız.</span> Bağlandıktan sonra bot DM ile 2FA aktifleştirebilirsiniz.`;
            actionDiscord.innerHTML = `
              <button type="button" onclick="switchSettingsTab('tab-discord')" class="px-4 py-2 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center gap-1.5">
                <i class="fa-brands fa-discord"></i>
                <span>Discord Hesabını Bağla</span>
              </button>
            `;
          } else if (hasDiscord2Fa) {
            // Discord 2FA aktif
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-green-100 text-green-700';
            badgeDiscord.innerText = 'Aktif';
            if (discord2FaSub) discord2FaSub.innerText = `Giriş sırasında @${dUsername || 'Discord'} hesabına bot DM ile kod gönderilir.`;
            actionDiscord.innerHTML = `
              <button type="button" onclick="openDisable2FaModal()" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all">
                Kapat
              </button>
            `;
          } else {
            // Discord bağlı ama 2FA kapalı
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-100 text-blue-700';
            badgeDiscord.innerText = 'Açılabilir';
            if (discord2FaSub) discord2FaSub.innerText = `@${dUsername || 'Discord'} hesabınız bağlı. Aktifleştirmek için bota onay kodu gönderin.`;
            actionDiscord.innerHTML = `
              <button type="button" onclick="startDiscord2FaSetup()" class="px-4 py-2 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center gap-1.5">
                <i class="fa-brands fa-discord"></i>
                <span>Discord 2FA Aktifleştir</span>
              </button>
            `;
          }
        }
      } catch (e) {
        console.error('2FA status load error:', e);
        if (overallBadge) overallBadge.innerText = 'Hata';
      }
    }

    // Authenticator Setup Flow
    async function startAuthenticatorSetup() {
      openModal('modalAuthSetup');
      const qrContainer = document.getElementById('authQrContainer');
      const secretEl = document.getElementById('authSecretCode');
      qrContainer.innerHTML = '<span class="text-xs text-gray-400 font-bold animate-pulse">QR Kod Yükleniyor...</span>';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/authenticator/setup', {
          method: 'POST',
        });
        const data = await res.json();
        const payload = data.data || data;

        const qr = payload.qrCode || data.qrCode;
        const secret = payload.secret || data.secret;

        if (qr) {
          qrContainer.innerHTML = `<img src="${qr}" class="w-full h-full object-contain" alt="2FA QR Code">`;
        }
        if (secret) {
          secretEl.innerText = secret;
        }
      } catch (e) {
        showToast('Authenticator kurulumu başlatılamadı.', 'error');
      }
    }

    function copyAuthSecret() {
      const code = document.getElementById('authSecretCode')?.innerText;
      if (code && code !== '...') {
        navigator.clipboard.writeText(code);
        showToast('Kurulum anahtarı kopyalandı!', 'success');
      }
    }

    document.getElementById('formVerifyAuthSetup')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('authSetupCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitAuthSetup');
      btn.disabled = true;
      btn.innerText = 'Doğrulanıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/authenticator/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          closeModal('modalAuthSetup');
          document.getElementById('authSetupCodeInput').value = '';
          showToast(result.message || payload.message || 'Authenticator başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();

          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) {
            displayRecoveryCodes(codes);
          }
        } else {
          showToast(result.message || payload.message || 'Geçersiz doğrulama kodu.', 'error');
        }
      } catch (err) {
        showToast('Doğrulama hatası!', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Doğrula ve Aktifleştir';
      }
    });

    // Email 2FA Setup Flow
    async function startEmail2FaSetup() {
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/email/send-code', {
          method: 'POST',
        });
        const data = await res.json();
        if (data.success) {
          showToast('Doğrulama kodu e-postanıza gönderildi.', 'success');
          openModal('modalEmailSetup');
        } else {
          showToast(data.message || 'Kod gönderilemedi.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      }
    }

    document.getElementById('formVerifyEmailSetup')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('emailSetupCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitEmailSetup');
      btn.disabled = true;
      btn.innerText = 'Doğrulanıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/email/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          closeModal('modalEmailSetup');
          document.getElementById('emailSetupCodeInput').value = '';
          showToast(result.message || payload.message || 'E-Posta 2FA başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();

          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) {
            displayRecoveryCodes(codes);
          }
        } else {
          showToast(result.message || payload.message || 'Geçersiz kod.', 'error');
        }
      } catch (err) {
        showToast('Doğrulama hatası.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'E-Posta 2FA\'yı Aktifleştir';
      }
    });

    // Primary Method Update
    async function updatePrimary2FaMethod(method) {
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/primary-method', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ method }),
        });
        const data = await res.json();
        if (data.success) {
          showToast('Birincil 2FA yöntemi güncellendi.', 'success');
          await loadTwoFaStatus();
        } else {
          showToast(data.message || 'Güncellenemedi.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      }
    }

    // Display & Regenerate Recovery Codes
    function displayRecoveryCodes(codes) {
      generatedRecoveryCodesCache = codes;
      const grid = document.getElementById('recoveryCodesGrid');
      if (grid) {
        grid.innerHTML = codes.map((c) => `<div class="p-2 bg-white rounded-lg border border-gray-200 tracking-wider font-mono font-bold">${c}</div>`).join('');
      }
      openModal('modalRecoveryCodes');
    }

    function copyRecoveryCodes() {
      if (generatedRecoveryCodesCache.length > 0) {
        navigator.clipboard.writeText(generatedRecoveryCodesCache.join('\n'));
        showToast('Tüm kurtarma kodları kopyalandı!', 'success');
      }
    }

    async function regenerateRecoveryCodes() {
      if (!confirm('Yeni kurtarma kodları üretilsin mi? Eski kurtarma kodlarınız geçersiz olacaktır.')) return;
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/recovery-codes/regenerate', {
          method: 'POST',
        });
        const result = await res.json();
        const payload = result.data || result;
        const codes = result.recoveryCodes || payload.recoveryCodes || [];

        if ((result.success || payload.success) && codes.length > 0) {
          displayRecoveryCodes(codes);
          await loadTwoFaStatus();
          showToast('Yeni kurtarma kodları başarıyla üretildi.', 'success');
        } else {
          showToast(result.message || payload.message || 'Kodlar üretilemedi.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      }
    }

    // Disable 2FA
    function openDisable2FaModal() {
      openModal('modalDisable2Fa');
    }

    // Discord 2FA Setup
    async function startDiscord2FaSetup() {
      const btn = document.getElementById('actionDiscord2Fa')?.querySelector('button');
      if (btn) { btn.disabled = true; btn.innerText = 'Aktifleştiriliyor...'; }
      try {
        const discordId = window.__currentUserDiscordId || '';
        const res = await fetch('/api/storefront/v2/users/me/2fa/discord/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ discordId }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          showToast(result.message || payload.message || 'Discord 2FA başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();
          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) displayRecoveryCodes(codes);
        } else {
          showToast(result.message || payload.message || 'Discord 2FA aktifleştirilemedi.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-brands fa-discord"></i><span>Discord 2FA Aktifleştir</span>'; }
      }
    }

    document.getElementById('formDisable2Fa')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('disable2FaCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitDisable2Fa');
      btn.disabled = true;
      btn.innerText = 'Kapatılıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/disable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        if (result.success) {
          closeModal('modalDisable2Fa');
          document.getElementById('disable2FaCodeInput').value = '';
          showToast('2FA başarıyla devre dışı bırakıldı.', 'success');
          await loadTwoFaStatus();
        } else {
          showToast(result.message || 'Geçersiz 2FA kodu.', 'error');
        }
      } catch (e) {
        showToast('Bağlantı hatası.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = '2FA\'yı Kapat';
      }
    });

    // ==========================================
    // GENEL PROFİL FORMU SUBMIT & INITIAL LOAD
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('settings-form');
      const btnSave = document.getElementById('btn-save-settings');
      const inputEmail = document.getElementById('input-email');
      const inputPassword = document.getElementById('input-new-password');
      const successBox = document.getElementById('settings-success');
      const errorBox = document.getElementById('settings-error');
      const errorText = document.getElementById('settings-error-text');
      const customerId = '{{ customer.id }}';

      // Load dynamic statuses
      loadDiscordStatus();
      loadTwoFaStatus();

      // Check URL parameters for tab or discord redirect status
      const params = new URLSearchParams(window.location.search);
      const discordStatus = params.get('discord_status');
      const discordErr = params.get('discord_error');
      const tabParam = params.get('tab');

      if (discordStatus === 'connected') {
        showToast('Discord hesabınız başarıyla bağlandı!', 'success');
        switchSettingsTab('tab-discord');
        window.history.replaceState({}, '', '/profile/settings');
      } else if (discordErr) {
        showToast(decodeURIComponent(discordErr), 'error');
        switchSettingsTab('tab-discord');
      } else if (tabParam === 'discord') {
        switchSettingsTab('tab-discord');
      } else if (tabParam === '2fa') {
        switchSettingsTab('tab-2fa');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        successBox.classList.add('hidden');
        errorBox.classList.add('hidden');
        btnSave.disabled = true;
        btnSave.innerText = 'Kaydediliyor...';

        const email = inputEmail.value.trim();
        const currentPassword = document.getElementById('input-current-password')?.value.trim();
        const password = inputPassword.value.trim();

        try {
          if (email !== '{{ customer.email }}') {
            const res = await fetch(`/api/storefront/v2/users/${customerId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const data = await res.json();
            if (!data.success) {
              throw new Error(data.message || 'E-posta güncellenemedi.');
            }
          }

          if (password || currentPassword) {
            if (!currentPassword || !password) {
              throw new Error('Şifrenizi değiştirmek için hem mevcut hem de yeni şifrenizi girmelisiniz.');
            }
            if (password.length < 8) {
              throw new Error('Yeni şifre en az 8 karakter olmalıdır.');
            }

            const pRes = await fetch(`/api/storefront/v2/users/${customerId}/change-password`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ currentPassword: currentPassword, newPassword: password }),
            });
            const pData = await pRes.json();
            if (!pData.success) {
              throw new Error(pData.message || 'Şifre güncellenemedi.');
            }
          }

          successBox.classList.remove('hidden');
          if (password) {
            document.getElementById('input-current-password').value = '';
            inputPassword.value = '';
          }
        } catch (err) {
          errorText.innerText = err.message || 'Bilinmeyen bir hata oluştu.';
          errorBox.classList.remove('hidden');
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = 'Değişiklikleri Kaydet';
        }
      });
    });
  </script>
{% else %}
  <div class="min-h-[50vh] flex items-center justify-center">
    <div class="text-center">
      <h2 class="text-2xl font-black text-gray-900 mb-2">Giriş Yapmalısınız</h2>
      <p class="text-gray-500 font-medium mb-6">Ayarlarınızı görüntülemek için hesabınıza giriş yapmanız gerekmektedir.</p>
      <a href="/auth" class="px-8 py-3 bg-primary text-white font-bold rounded-xl hover:brightness-110 transition-colors shadow-md">Giriş Yap</a>
    </div>
  </div>
{% endif %}
