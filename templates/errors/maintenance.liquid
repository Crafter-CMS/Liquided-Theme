<div class="flex-grow flex items-center justify-center p-4 bg-base">
  <div class="max-w-md w-full bg-white border border-gray-200 rounded-2xl p-8 md:p-10 shadow-sm text-center">

    <div class="w-20 h-20 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm border border-primary/10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
    </div>

    <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-3">
      {{ settings.maintenance.title | default: 'Bakım Çalışması' }}
    </h1>
    <p class="text-gray-500 font-medium mb-8 max-w-sm mx-auto leading-relaxed">
      {{ settings.maintenance.description | default: 'Şu anda sistemlerimizde planlı bir bakım çalışması yürütülmektedir. Çok yakında geri döneceğiz. Anlayışınız için teşekkür ederiz.' }}
    </p>

    <a href="/auth/sign-in" class="inline-block px-6 py-3 bg-gray-50 hover:bg-gray-100 transition-colors rounded-xl border border-gray-200 text-sm font-bold text-gray-600">
      {{ settings.maintenance.footer_text | default: 'Yetkiniz varsa giriş yapıp görüntüleyebilirsiniz' }}
    </a>
  </div>
</div>
