<div class="container max-w-[1400px] mx-auto px-4 mt-8 mb-24 space-y-10">
  <div class="flex items-center gap-2 text-sm font-bold text-gray-500 bg-white py-3 px-6 rounded-2xl w-fit shadow-sm border border-gray-100">
    <a href="/" class="hover:text-primary transition-colors">Ana sayfa</a>
    <span>/</span>
    <span class="text-gray-900">Mağaza</span>
  </div>

  <section class="relative overflow-hidden rounded-[2rem] bg-gray-950 text-white p-8 md:p-12">
    <div class="relative z-10 max-w-2xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-white/50 mb-3">{{ settings.store.kicker | default: 'Katalog' }}</p>
      <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
        {{ settings.store.banner_title | default: 'Mağaza' }}
      </h1>
      <p class="text-lg text-white/70 font-medium">
        {{ settings.store.banner_description | default: 'Oyun içi teslimat, dijital kod ve indirilebilir dosyalar aynı katalogda.' }}
      </p>
    </div>
    {% if settings.store.banner_image %}
      <img src="{{ settings.store.banner_image }}" alt="" class="absolute inset-y-0 right-0 hidden md:block w-1/2 h-full object-cover opacity-30">
    {% endif %}
  </section>

  {% if servers and servers.size > 0 %}
    <section>
      <h2 class="text-xl font-black text-gray-900 mb-4">Sunucular</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for server in servers %}
          {% assign game = server.game | default: 'minecraft' %}
          <a href="/store/{{ server.slug }}" class="group relative overflow-hidden rounded-3xl min-h-[150px] bg-gray-900 block">
            {% if server.image != blank %}
              <img src="{{ server.image }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500">
            {% endif %}
            <div class="relative z-10 h-full p-6 flex flex-col justify-end">
              <span class="text-[10px] font-black uppercase tracking-widest text-white/80 mb-2">
                {% case game %}
                  {% when 'fivem' %}FiveM
                  {% when 'rust' %}Rust
                  {% when 'gmod' %}Garry's Mod
                  {% when 'cs2' %}CS2
                  {% when 'ark' %}ARK
                  {% when 'dayz' %}DayZ
                  {% when 'empyrion' %}Empyrion
                  {% when 'mtasa' %}MTA:SA
                  {% when 'samp' %}SA-MP
                  {% when 'forest' %}The Forest
                  {% when 'unturned' %}Unturned
                  {% when 'valheim' %}Valheim
                  {% else %}Minecraft
                {% endcase %}
              </span>
              <h3 class="text-2xl font-black text-white">{{ server.name }}</h3>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% render 'catalog-browser' %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.CrafterStore) window.CrafterStore.mountCatalog({});
  });
</script>
