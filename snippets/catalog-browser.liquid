<div id="store-type-row" class="hidden"></div>

<section class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8">
  <form id="store-filter-form" class="bg-white border border-gray-100 rounded-[1.75rem] p-5 h-fit lg:sticky lg:top-24 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-black text-gray-900">Filtreler</h2>
      <button type="reset" class="text-xs font-bold text-gray-400 hover:text-gray-900">Temizle</button>
    </div>
    <label class="relative block">
      <span class="sr-only">Ürün ara</span>
      <input id="store-search" name="q" type="search" placeholder="Ürün ara" class="w-full rounded-2xl bg-gray-50 border border-gray-100 px-4 py-3 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-300">
    </label>
    <div class="mt-5">
      <h3 class="text-sm font-black text-gray-900 mb-3">Fiyat</h3>
      <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
        <input name="priceMin" type="number" min="0" placeholder="En az" class="w-full rounded-2xl bg-gray-50 border border-gray-100 px-3 py-2.5 text-sm">
        <span class="text-gray-300">–</span>
        <input name="priceMax" type="number" min="0" placeholder="En çok" class="w-full rounded-2xl bg-gray-50 border border-gray-100 px-3 py-2.5 text-sm">
      </div>
    </div>
    <label class="mt-4 flex items-center justify-between gap-3 rounded-2xl bg-gray-50 border border-gray-100 px-3 py-2.5 cursor-pointer">
      <span class="text-sm font-bold text-gray-800">Yalnızca stokta olanlar</span>
      <input name="available" type="checkbox" class="peer sr-only">
      <span class="relative h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-gray-900 after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-5"></span>
    </label>
    <div data-filter-groups></div>
  </form>

  <div>
    <div id="store-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 min-h-[20rem]"></div>
  </div>
</section>
